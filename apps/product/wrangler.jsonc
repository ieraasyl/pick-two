{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pick-two-product",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_als"],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "vars": {
    "APP_ENV": "development",
    "BETTER_AUTH_URL": "http://localhost:5173",
    "AUTH_EMAIL_FROM": "onboarding@resend.dev",
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pick-two-product-dev",
      "database_id": "6949960d-8409-4b22-86cb-0ccb541343ca",
      "migrations_dir": "drizzle",
    },
  ],
  "env": {
    "production": {
      "name": "pick-two-product-production",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://pick-two-product-production.ieraasyl.workers.dev",
        "AUTH_EMAIL_FROM": "Pick Two <auth@mail.ieraasyl.dev>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pick-two-product-production",
          "database_id": "0f7dd0fa-be38-49f0-a46f-4a588f1896f9",
          "migrations_dir": "drizzle",
        },
      ],
    },
    "staging": {
      "name": "pick-two-product-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "BETTER_AUTH_URL": "https://pick-two-product-staging.ieraasyl.workers.dev",
        "AUTH_EMAIL_FROM": "Pick Two Staging <onboarding@resend.dev>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pick-two-product-staging",
          "database_id": "1ebbf455-45f9-4e3a-95d3-9bd5de52a74b",
          "migrations_dir": "drizzle",
        },
      ],
    },
  },
}
